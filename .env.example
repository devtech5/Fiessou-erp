# Copier vers .env.local et adapter. Ne jamais committer .env.local.

# --------------------------------------------------------------- base de données
#
# Fiessou parle à PostgreSQL directement, via Drizzle. Aucun SDK d'hébergeur
# n'est requis — Supabase sert de PostgreSQL managé, rien de plus.
#
# DEUX chaînes, qui ne diffèrent que par le PORT. Elles ne sont pas
# interchangeables :
#
#   · 6543 — pooler en mode transaction, pour l'application. La connexion
#     retourne au pool après chaque requête ; les requêtes préparées sont donc
#     désactivées automatiquement et le pool local est ramené à 1.
#
#   · 5432 — pooler en mode session, pour les migrations. drizzle-kit modifie
#     le schéma et exige une session stable.
#
# COPIER les chaînes depuis Supabase, ne pas les reconstruire : bouton
# « Connect » en haut du projet, onglets « Transaction pooler » et « Session
# pooler ». L'hôte varie selon la région ET le préfixe (aws-0, aws-1…), et un
# pooler qui n'héberge pas le projet répond « tenant/user not found » — une
# erreur qui ressemble à un problème d'identifiants sans en être un.
#
# Seule modification à apporter à la chaîne copiée : remplacer
# [YOUR-PASSWORD] par le mot de passe. S'il contient @ : / ? # ou %, ces
# caractères doivent être encodés — @ s'écrit %40, sinon l'URL est coupée au
# mauvais endroit.
DATABASE_URL=""
DATABASE_URL_MIGRATION=""

# PostgreSQL local, si besoin un jour (voir docker-compose.yml). Le projet
# travaille directement sur Supabase : ce mode n'est pas la voie normale.
# DATABASE_URL="postgres://fiessou:fiessou_dev@localhost:5432/fiessou"

# ------------------------------------------------------------------- sécurité
#
# Clé de signature des jetons de session. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ------------------------------------------------------------------- métier
#
# Pays par défaut d'une nouvelle entreprise (ISO 3166-1 alpha-2).
# Pilote la fiscalité, la paie et les moyens de paiement proposés.
DEFAULT_COUNTRY="CI"

# Instance de démonstration : bandeau « données fictives » sur toutes les
# pages. 1 pour une instance de présentation, 0 partout ailleurs.
#
# La connexion se fait par adresse e-mail et mot de passe. Le compte de
# démonstration se crée avec `pnpm demo:compte` (DEMO_MOT_DE_PASSE facultatif).
INSTANCE_DEMO="0"

# ------------------------------------------------------ dépôt de fichiers
#
# Requis uniquement pour le module Documents. Sans ces variables, la
# bibliothèque se lit toujours et seul l'ajout de fichier refuse.
#
# L'URL se déduit du ref du projet, déjà présent dans DATABASE_URL :
# https://<ref>.supabase.co
#
# La clé se prend dans Settings -> API Keys -> service_role. Elle CONTOURNE RLS
# sur tout le projet : jamais de préfixe NEXT_PUBLIC_, jamais côté navigateur.
#
# Le bucket se crée dans Storage -> New bucket, et il doit être PRIVÉ. Public,
# toute pièce d'identité et tout contrat deviennent lisibles par quiconque
# devine l'adresse. Un bucket privé se lit par URL signée, à durée limitée,
# générée côté serveur au moment où l'écran s'ouvre.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documents"

# Dépôt sur disque pour le développement sans Supabase. `pnpm dev:local` le
# renseigne tout seul (.pglite/fichiers). Ignoré en production.
STOCKAGE_LOCAL=""

# Modules à ouvrir malgré leurs écrans sur jeu d'essai.
#
# Clés du registre (`src/modules/registry.ts`) séparées par des virgules, ou
# `*` pour toutes. Vide en production : un module dont les chiffres sont
# inventés reste fermé, et le tableau de bord n'en affiche aucune alerte.
#
# Renseignée, la liste fait foi partout — c'est ainsi qu'on voit localement ce
# que le client verra. Vide, le développement ouvre tout et la production ne
# s'ouvre à rien.
#
#   MODULES_APERCU="*"                    instance de démonstration
#   MODULES_APERCU="reservation,actifs"   ouverture ciblée, pour une visite
MODULES_APERCU=""

# WhatsApp Business (API Cloud de Meta) — messages aux clients et au personnel.
# Hors d'une conversation ouverte par le client dans les 24 h, seul un modèle
# approuvé passe : WHATSAPP_MODELE, un corps à une variable {{1}}.
WHATSAPP_JETON=
WHATSAPP_NUMERO_ID=
WHATSAPP_MODELE=
WHATSAPP_LANGUE=fr
