# Copier vers .env.local et adapter. Ne jamais committer .env.local.

# --------------------------------------------------------------- base de données
#
# Chaîne de connexion PostgreSQL. Fiessou parle à Postgres directement, via
# Drizzle — aucun SDK d'hébergeur n'est requis.
#
# Local (voir docker-compose.yml) :
DATABASE_URL="postgres://fiessou:fiessou_dev@localhost:5432/fiessou"
#
# Supabase — deux chaînes différentes, à ne pas confondre :
#
#   · Application (port 6543, pooler en mode transaction). C'est celle-ci qu'il
#     faut ici. Le pool est ramené à 1 connexion et les requêtes préparées sont
#     désactivées automatiquement, sans quoi la base renvoie par intermittence
#     « prepared statement already exists ».
#     postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   · Migrations (port 5432, connexion directe ou pooler en mode session).
#     drizzle-kit modifie le schéma : il lui faut une session stable.
#     Renseigner DATABASE_URL_MIGRATION ci-dessous si elle diffère.
#
# DATABASE_URL_MIGRATION=""

# ------------------------------------------------------------------- sécurité
#
# Clé de signature des jetons de session. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ------------------------------------------------------------------- métier
#
# Pays par défaut d'une nouvelle entreprise (ISO 3166-1 alpha-2).
# Pilote la fiscalité, la paie et les moyens de paiement proposés.
DEFAULT_COUNTRY="CI"

# Canal d'envoi des codes de vérification : console | sms | whatsapp
# "console" écrit le code dans les logs — développement uniquement.
OTP_CHANNEL="console"
