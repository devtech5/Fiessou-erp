# Copier vers .env.local et adapter. Ne jamais committer .env.local.

# --------------------------------------------------------------- base de données
#
# Fiessou parle à n'importe quel PostgreSQL directement, via Drizzle. Aucun
# SDK d'hébergeur n'est requis.
#
# Sans PostgreSQL installé, `pnpm dev:local` démarre sur PGlite (.pglite/) et
# ignore cette variable.
#
# En production (Dokploy) : l'Internal Connection URL de la base du projet.
# En local, avec docker-compose.yml :
#   DATABASE_URL="postgres://fiessou:fiessou_dev@localhost:5432/fiessou"
#
# Un mot de passe contenant @ : / ? # ou % doit être encodé — @ s'écrit %40,
# sinon l'URL est coupée au mauvais endroit.
DATABASE_URL=""

# Facultative. Seulement derrière un pooler en mode transaction (PgBouncer) :
# les migrations exigent une session stable et passent alors par une
# connexion directe. Vide, les migrations utilisent DATABASE_URL.
DATABASE_URL_MIGRATION=""

# ------------------------------------------------------------------- sécurité
#
# Clé de signature des jetons de session. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ------------------------------------------------------------------- métier
#
# Pays par défaut d'une nouvelle entreprise (ISO 3166-1 alpha-2).
# Pilote la fiscalité, la paie et les moyens de paiement proposés.
DEFAULT_COUNTRY="CI"

# Instance de démonstration : bandeau « données fictives » sur toutes les
# pages. 1 pour une instance de présentation, 0 partout ailleurs.
#
# La connexion se fait par adresse e-mail et mot de passe. Les comptes de
# démonstration (propriétaire demo@fiessou.ci, gérant gerant@fiessou.ci) se
# créent avec `pnpm demo:compte` — DEMO_MOT_DE_PASSE et
# DEMO_MOT_DE_PASSE_GERANT facultatifs, tirés au hasard sinon.
INSTANCE_DEMO="0"

# ------------------------------------------------------ dépôt de fichiers
#
# Dossier où vont les pièces jointes (photos, preuves de paiement,
# documents). Sans lui, la bibliothèque se lit toujours et seul l'ajout de
# fichier refuse.
#
# `pnpm dev:local` le renseigne tout seul (.pglite/fichiers). En production,
# un volume persistant et sauvegardé (/donnees/fichiers dans l'image) —
# jamais un disque éphémère. Les fichiers se lisent par URL signée HMAC
# (AUTH_SECRET) qui expire : aucun lien direct.
STOCKAGE_LOCAL=""

# Modules à ouvrir malgré leurs écrans sur jeu d'essai.
#
# Clés du registre (`src/modules/registry.ts`) séparées par des virgules, ou
# `*` pour toutes. Vide en production : un module dont les chiffres sont
# inventés reste fermé, et le tableau de bord n'en affiche aucune alerte.
#
# Renseignée, la liste fait foi partout — c'est ainsi qu'on voit localement ce
# que le client verra. Vide, le développement ouvre tout et la production ne
# s'ouvre à rien.
#
#   MODULES_APERCU="*"                    instance de démonstration
#   MODULES_APERCU="reservation,actifs"   ouverture ciblée, pour une visite
MODULES_APERCU=""

# WhatsApp Business (API Cloud de Meta) — messages aux clients et au personnel.
# Hors d'une conversation ouverte par le client dans les 24 h, seul un modèle
# approuvé passe : WHATSAPP_MODELE, un corps à une variable {{1}}.
WHATSAPP_JETON=
WHATSAPP_NUMERO_ID=
WHATSAPP_MODELE=
WHATSAPP_LANGUE=fr
