# HTTPS automatique (Let's Encrypt) pour le domaine de DOMAINE.
# Le DNS du domaine doit pointer vers le VPS AVANT le premier démarrage.
{$DOMAINE} {
	encode zstd gzip

	# Pièces jointes jusqu'à 10 Mo, plus l'enveloppe multipart.
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}
